{
  "name": "c12",
  "version": "4.0.0-beta.5",
  "description": "Smart Config Loader",
  "license": "MIT",
  "repository": "unjs/c12",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./update": "./dist/update.mjs"
  },
  "scripts": {
    "build": "obuild",
    "dev": "vitest dev",
    "lint": "oxlint . && oxfmt --check src test",
    "lint:fix": "automd && oxlint . --fix && oxfmt src test",
    "release": "pnpm test && pnpm build && changelogen --release --prerelease --push && npm publish --tag latest",
    "test": "pnpm lint && vitest run --coverage && pnpm test:types",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "confbox": "^0.2.4",
    "defu": "^6.1.7",
    "exsolve": "^1.1.1",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "rc9": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4.1.11",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint-config-unjs": "^0.6.2",
    "expect-type": "^1.4.0",
    "giget": "^3.3.1",
    "jiti": "^2.7.0",
    "magicast": "^0.5.4",
    "obuild": "^0.4.39",
    "ohash": "^2.0.12",
    "oxfmt": ">=0.65.0",
    "oxlint": "^1.81.0",
    "perfect-debounce": "^2.1.0",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "chokidar": "^5",
    "dotenv": "*",
    "giget": "*",
    "jiti": "*",
    "magicast": "*"
  },
  "peerDependenciesMeta": {
    "dotenv": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "chokidar": {
      "optional": true
    },
    "jiti": {
      "optional": true
    },
    "giget": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.22.0"
}
